+		struct IntelXeDeviceInfo {
+			uint32_t version;
+			uint32_t platform;
+			uint16_t deviceId;
+			uint16_t graphicsVerx100;
+			uint16_t mediaVerx100;
+			uint16_t displayVer;
+			uint8_t bar2Mapped;
+			uint8_t hasFlatCcs;
+			uint8_t hasDisplay;
+			uint8_t up;
+			uint64_t bar2Length;
