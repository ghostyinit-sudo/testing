+		r->up = up ? 1 : 0;
+		r->bar2Length = bar2 ? (uint64_t)bar2->getLength() : 0ull;
+		return kIOReturnSuccess;
+	}
 	return IOService::callPlatformFunction(fn, wait, p1, p2, p3, p4);
 }
